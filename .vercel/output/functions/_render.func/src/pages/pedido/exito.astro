---
import Layout from "../../layouts/Layout.astro";
import UtilityBar from "../../components/UtilityBar.astro";
import Header from "../../components/Header.astro";
import { confirmPayment } from "../../lib/confirm-payment";

const paymentId = Astro.url.searchParams.get("payment_id");
const externalReference = Astro.url.searchParams.get("external_reference");

// Respaldo por si el webhook todavía no llegó (por ejemplo, en desarrollo
// local sin túnel HTTPS Mercado Pago no puede alcanzar notification_url).
// confirmPayment() es idempotente, así que no pasa nada si el webhook
// también confirma este mismo pago un segundo después.
if (paymentId) {
  try {
    await confirmPayment(paymentId);
  } catch (error) {
    console.error("[Lester] No se pudo confirmar el pago en la página de éxito:", error);
  }
}
---

<Layout title="¡Gracias por tu compra! — Lester">
  <UtilityBar />
  <Header />

  <div class="mx-auto max-w-lg px-6 py-20 text-center sm:px-10">
    <p class="font-display text-3xl uppercase tracking-wide text-bone">¡Gracias por tu compra!</p>
    <p class="mt-3 text-sm text-bone/60">
      Tu pago se procesó correctamente{externalReference && <> — pedido <span class="text-bone">#{externalReference.slice(0, 8)}</span></>}.
    </p>
    <a
      href="/"
      class="mt-8 inline-block border border-steel px-6 py-2.5 text-xs uppercase tracking-widest text-steel transition-colors hover:bg-steel hover:text-black"
    >
      Seguir comprando
    </a>
  </div>
</Layout>

<script>
  // El carrito ya se pagó — lo vaciamos.
  localStorage.removeItem("cart");
  window.dispatchEvent(new CustomEvent("lester:store-update"));
</script>
