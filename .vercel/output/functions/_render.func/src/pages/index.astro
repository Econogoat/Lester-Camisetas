---
import Layout from "../layouts/Layout.astro";
import UtilityBar from "../components/UtilityBar.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import FiltersSidebar from "../components/FiltersSidebar.astro";
import BreadcrumbResults from "../components/BreadcrumbResults.astro";
import ProductGrid from "../components/ProductGrid.astro";
import { getPublicProducts } from "../lib/products-query";

const products = await getPublicProducts();
---

<Layout>
  <UtilityBar />
  <Header wishlistCount={0} cartCount={0} />
  <Hero />

  <div class="lg:flex">
    <FiltersSidebar products={products} />

    <div class="min-w-0 flex-1">
      <BreadcrumbResults count={products.length} />
      <ProductGrid products={products} />
    </div>
  </div>
</Layout>
