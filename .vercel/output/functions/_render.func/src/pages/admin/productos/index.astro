---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { Plus, Pencil, Trash2, Search } from "lucide-astro";
import { actions } from "astro:actions";

const deleteResult = Astro.getActionResult(actions.products.remove);

const q = Astro.url.searchParams.get("q")?.trim() ?? "";

let query = Astro.locals.supabase
  .from("products")
  .select(
    "id, club_seleccion, liga, temporada, tipo, precio, imagen_frente, activo, product_variants(stock)"
  )
  .order("created_at", { ascending: false });

if (q) {
  query = query.ilike("club_seleccion", `%${q}%`);
}

const { data: products, error } = await query;
---

<AdminLayout title="Productos — Panel Lester">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="font-display text-2xl uppercase tracking-wide text-bone">Productos</h1>
      <p class="mt-1 text-sm text-bone/50">
        {products?.length ?? 0} producto{products?.length === 1 ? "" : "s"}
      </p>
    </div>
    <a
      href="/admin/productos/nuevo"
      class="font-inter flex items-center gap-2 border border-steel bg-steel px-4 py-2 text-xs uppercase tracking-widest text-black transition-opacity hover:opacity-90"
    >
      <Plus class="h-4 w-4" strokeWidth={2} aria-hidden="true" />
      Nuevo producto
    </a>
  </div>

  <form method="GET" class="mt-6 max-w-sm">
    <label class="relative flex items-center">
      <Search class="pointer-events-none absolute left-3 h-4 w-4 text-bone/40" strokeWidth={1.75} aria-hidden="true" />
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Buscar por club o selección..."
        class="w-full border border-white/10 bg-white/5 py-2.5 pl-9 pr-3 text-sm text-bone placeholder:text-bone/40 outline-none focus:border-steel"
      />
    </label>
  </form>

  {error && <p class="mt-6 text-sm text-ember">Error cargando productos: {error.message}</p>}
  {deleteResult?.error && <p class="mt-6 text-sm text-ember">{deleteResult.error.message}</p>}

  <div class="mt-6 overflow-x-auto border border-white/10">
    <table class="w-full min-w-[720px] text-left text-sm">
      <thead>
        <tr class="border-b border-white/10 text-xs uppercase tracking-wider text-bone/50">
          <th class="px-4 py-3 font-medium">Producto</th>
          <th class="px-4 py-3 font-medium">Tipo</th>
          <th class="px-4 py-3 font-medium">Temporada</th>
          <th class="px-4 py-3 font-medium">Precio</th>
          <th class="px-4 py-3 font-medium">Stock</th>
          <th class="px-4 py-3 font-medium">Estado</th>
          <th class="px-4 py-3 text-right font-medium">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {
          (products ?? []).map((p: any) => {
            const stock = (p.product_variants ?? []).reduce(
              (sum: number, v: { stock: number }) => sum + v.stock,
              0
            );
            return (
              <tr class="border-b border-white/5 last:border-b-0">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 shrink-0 overflow-hidden bg-ink-raised">
                      {p.imagen_frente && <img src={p.imagen_frente} alt="" class="h-full w-full object-cover" />}
                    </div>
                    <div>
                      <p class="text-bone">{p.club_seleccion}</p>
                      <p class="text-xs text-bone/50">{p.liga}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 capitalize text-bone/80">{p.tipo}</td>
                <td class="px-4 py-3 text-bone/80">{p.temporada}</td>
                <td class="px-4 py-3 text-bone/80">$ {Number(p.precio).toLocaleString("es-AR")}</td>
                <td class="px-4 py-3 text-bone/80">{stock}</td>
                <td class="px-4 py-3">
                  <span
                    class={`px-2 py-0.5 text-[10px] uppercase tracking-wide ${
                      p.activo ? "bg-steel text-black" : "bg-white/10 text-bone/50"
                    }`}
                  >
                    {p.activo ? "Activo" : "Oculto"}
                  </span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-3">
                    <a href={`/admin/productos/${p.id}`} aria-label="Editar" class="text-bone/60 hover:text-bone">
                      <Pencil class="h-4 w-4" strokeWidth={1.75} aria-hidden="true" />
                    </a>
                    <form
                      method="POST"
                      action={actions.products.remove}
                      data-confirm="¿Eliminar este producto? Esta acción no se puede deshacer."
                    >
                      <input type="hidden" name="id" value={p.id} />
                      <button type="submit" aria-label="Eliminar" class="text-bone/60 hover:text-ember">
                        <Trash2 class="h-4 w-4" strokeWidth={1.75} aria-hidden="true" />
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>

    {(products ?? []).length === 0 && (
      <p class="px-4 py-8 text-center text-sm text-bone/50">No hay productos todavía.</p>
    )}
  </div>
</AdminLayout>

<script>
  document.querySelectorAll("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (e) => {
      const message = form.getAttribute("data-confirm");
      if (message && !confirm(message)) {
        e.preventDefault();
      }
    });
  });
</script>
