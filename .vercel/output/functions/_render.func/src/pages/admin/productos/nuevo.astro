---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductForm from "../../../components/admin/ProductForm.astro";
import { actions, isInputError } from "astro:actions";

const result = Astro.getActionResult(actions.products.create);

if (result && !result.error) {
  return Astro.redirect("/admin/productos");
}

const fieldErrors = isInputError(result?.error) ? result.error.fields : undefined;
const formError = result?.error && !isInputError(result.error) ? result.error.message : undefined;
---

<AdminLayout title="Nuevo producto — Panel Lester">
  <h1 class="font-display text-2xl uppercase tracking-wide text-bone">Nuevo producto</h1>

  <div class="mt-6">
    <ProductForm action={actions.products.create} fieldErrors={fieldErrors} formError={formError} />
  </div>
</AdminLayout>
