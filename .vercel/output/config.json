{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/_actions(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/pedidos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/productos/nuevo/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/productos/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/productos/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/webhooks/mercadopago/?$",
			"dest": "_render"
		},
		{
			"src": "^/carrito/?$",
			"dest": "_render"
		},
		{
			"src": "^/pedido/error/?$",
			"dest": "_render"
		},
		{
			"src": "^/pedido/exito/?$",
			"dest": "_render"
		},
		{
			"src": "^/pedido/pendiente/?$",
			"dest": "_render"
		},
		{
			"src": "^/wishlist/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}