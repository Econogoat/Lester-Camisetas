---
import Layout from "../layouts/Layout.astro";
import UtilityBar from "../components/UtilityBar.astro";
import Header from "../components/Header.astro";
import { getPublicProducts } from "../lib/products-query";

// Traemos el catálogo real (precios/stock/fotos actuales) para poder mostrar
// cada línea del carrito — el carrito en sí vive en localStorage del
// navegador, así que se completa del lado del cliente con el script de abajo.
const products = await getPublicProducts();
const catalogJson = JSON.stringify(products).replace(/</g, "\\u003c");
---

<Layout title="Carrito — Lester">
  <UtilityBar />
  <Header />

  <div class="mx-auto max-w-3xl px-6 py-10 sm:px-10 lg:px-16">
    <h1 class="font-display text-2xl uppercase tracking-wide text-bone">Tu carrito</h1>

    <div data-cart-empty class="mt-10 hidden text-center">
      <p class="text-sm text-bone/60">Todavía no agregaste nada al carrito.</p>
      <a
        href="/"
        class="mt-4 inline-block border border-steel px-5 py-2.5 text-xs uppercase tracking-widest text-steel transition-colors hover:bg-steel hover:text-black"
      >
        Ver catálogo
      </a>
    </div>

    <div data-cart-items class="mt-8 divide-y divide-white/10 border-t border-white/10"></div>

    <div data-cart-summary class="hidden">
      <div class="flex items-center justify-between border-t border-white/10 pt-6">
        <p class="font-inter text-sm text-bone/60">Total</p>
        <p class="font-display text-2xl text-bone" data-cart-total>$ 0</p>
      </div>

      <div class="mt-4">
        <label for="checkout-email" class="block text-xs uppercase tracking-widest text-bone/60">Tu email</label>
        <input
          id="checkout-email"
          type="email"
          required
          placeholder="vos@email.com"
          class="mt-1.5 w-full border border-white/10 bg-white/5 px-3 py-2.5 text-sm text-bone placeholder:text-bone/40 outline-none focus:border-steel"
        />
        <p data-checkout-error class="mt-2 hidden text-xs text-ember"></p>
        <button
          type="button"
          id="checkout-button"
          class="mt-3 w-full border border-steel bg-steel py-3 text-xs uppercase tracking-widest text-black transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Finalizar compra
        </button>
      </div>
    </div>
  </div>
</Layout>

<script type="application/json" id="catalog-data" set:html={catalogJson} />

<script>
  import { getCart, setCartItemQuantity, removeCartItem, type CartItem } from "../lib/browser-store";
  import type { Product } from "../data/products";
  import { actions } from "astro:actions";

  const catalogDataEl = document.getElementById("catalog-data");
  const catalog: Product[] = catalogDataEl ? JSON.parse(catalogDataEl.textContent || "[]") : [];
  const catalogById = new Map(catalog.map((p) => [p.id, p]));

  const itemsContainer = document.querySelector("[data-cart-items]");
  const emptyState = document.querySelector("[data-cart-empty]");
  const summary = document.querySelector("[data-cart-summary]");
  const totalEl = document.querySelector("[data-cart-total]");
  const checkoutButton = document.getElementById("checkout-button") as HTMLButtonElement | null;
  const emailInput = document.getElementById("checkout-email") as HTMLInputElement | null;
  const checkoutError = document.querySelector("[data-checkout-error]");

  const formatPrice = (n: number) => `$ ${n.toLocaleString("es-AR")}`;

  const render = () => {
    if (!itemsContainer) return;
    const items = getCart();

    if (items.length === 0) {
      itemsContainer.innerHTML = "";
      emptyState?.classList.remove("hidden");
      summary?.classList.add("hidden");
      return;
    }

    emptyState?.classList.add("hidden");
    summary?.classList.remove("hidden");

    let total = 0;

    itemsContainer.innerHTML = items
      .map((item: CartItem) => {
        const product = catalogById.get(item.productId);
        if (!product) return "";

        const subtotal = product.price * item.cantidad;
        total += subtotal;

        const hasRealImage = product.imgFront && !product.imgFront.startsWith("[");
        const media = hasRealImage
          ? `<img src="${product.imgFront}" alt="" class="h-full w-full object-cover" />`
          : `<div class="flex h-full items-center justify-center"><span class="font-display text-3xl text-bone/10">${product.crest}</span></div>`;

        return `
          <div class="flex items-center gap-4 py-5" data-cart-row data-product-id="${item.productId}" data-talla="${item.talla}">
            <div class="h-16 w-16 shrink-0 overflow-hidden bg-ink-raised">${media}</div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-xs uppercase tracking-wide text-bone/50">${product.club}</p>
              <p class="truncate text-sm text-bone">${product.name}</p>
              <p class="mt-0.5 text-xs text-bone/50">Talle ${item.talla}</p>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" data-qty-decrease aria-label="Restar" class="h-7 w-7 border border-white/15 text-bone/70 transition-colors hover:border-steel hover:text-steel">−</button>
              <span class="w-6 text-center text-sm text-bone">${item.cantidad}</span>
              <button type="button" data-qty-increase aria-label="Sumar" class="h-7 w-7 border border-white/15 text-bone/70 transition-colors hover:border-steel hover:text-steel">+</button>
            </div>
            <p class="w-20 shrink-0 text-right text-sm text-bone">${formatPrice(subtotal)}</p>
            <button type="button" data-remove-item aria-label="Quitar" class="shrink-0 text-bone/40 transition-colors hover:text-ember">✕</button>
          </div>
        `;
      })
      .join("");

    if (totalEl) totalEl.textContent = formatPrice(total);

    itemsContainer.querySelectorAll("[data-cart-row]").forEach((row) => {
      const productId = row.getAttribute("data-product-id") ?? "";
      const talla = row.getAttribute("data-talla") ?? "";
      const current = items.find((i) => i.productId === productId && i.talla === talla);
      if (!current) return;

      row.querySelector("[data-qty-decrease]")?.addEventListener("click", () => {
        setCartItemQuantity(productId, talla, current.cantidad - 1);
        render();
      });
      row.querySelector("[data-qty-increase]")?.addEventListener("click", () => {
        setCartItemQuantity(productId, talla, current.cantidad + 1);
        render();
      });
      row.querySelector("[data-remove-item]")?.addEventListener("click", () => {
        removeCartItem(productId, talla);
        render();
      });
    });
  };

  render();
  window.addEventListener("lester:store-update", render);

  checkoutButton?.addEventListener("click", async () => {
    const email = emailInput?.value.trim() ?? "";
    checkoutError?.classList.add("hidden");

    if (!email) {
      if (checkoutError) {
        checkoutError.textContent = "Ingresá tu email para continuar.";
        checkoutError.classList.remove("hidden");
      }
      return;
    }

    const cartItems = getCart().map((item) => ({
      productId: item.productId,
      talla: item.talla,
      cantidad: item.cantidad,
    }));

    checkoutButton.disabled = true;
    checkoutButton.textContent = "Redirigiendo...";

    const { data, error } = await actions.checkout.create({ email, items: cartItems });

    if (error || !data?.checkoutUrl) {
      if (checkoutError) {
        checkoutError.textContent = error?.message ?? "No se pudo iniciar el pago. Probá de nuevo.";
        checkoutError.classList.remove("hidden");
      }
      checkoutButton.disabled = false;
      checkoutButton.textContent = "Finalizar compra";
      return;
    }

    window.location.href = data.checkoutUrl;
  });
</script>
