---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductForm from "../../../components/admin/ProductForm.astro";
import { actions, isInputError } from "astro:actions";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/productos");
}

const updateResult = Astro.getActionResult(actions.products.update);
if (updateResult && !updateResult.error) {
  return Astro.redirect("/admin/productos");
}

const { data: product, error } = await Astro.locals.supabase
  .from("products")
  .select(
    "id, club_seleccion, liga, temporada, tipo, version, precio, imagen_frente, imagen_espalda, activo, product_variants(talla, stock)"
  )
  .eq("id", id)
  .single();

if (error || !product) {
  return Astro.redirect("/admin/productos");
}

const fieldErrors = isInputError(updateResult?.error) ? updateResult.error.fields : undefined;
const formError = updateResult?.error && !isInputError(updateResult.error) ? updateResult.error.message : undefined;
---

<AdminLayout title={`Editar ${product.club_seleccion} — Panel Lester`}>
  <h1 class="font-display text-2xl uppercase tracking-wide text-bone">Editar producto</h1>

  <div class="mt-6">
    <ProductForm
      product={{
        id: product.id,
        club_seleccion: product.club_seleccion,
        liga: product.liga,
        temporada: product.temporada,
        tipo: product.tipo,
        version: product.version,
        precio: product.precio,
        imagen_frente: product.imagen_frente,
        imagen_espalda: product.imagen_espalda,
        activo: product.activo,
        variants: product.product_variants ?? [],
      }}
      action={actions.products.update}
      fieldErrors={fieldErrors}
      formError={formError}
    />
  </div>
</AdminLayout>
