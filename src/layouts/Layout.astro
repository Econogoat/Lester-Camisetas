---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lester — Camisetas de fútbol originales",
  description = "Curaduría experta de camisetas de clubes y selecciones nacionales. 100% originales, autenticidad verificada.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
