---
import { ShieldCheck } from "lucide-astro";
---

<div class="bg-black">
  <div
    class="mx-auto flex items-center justify-between gap-4 px-6 py-2 text-[11px] uppercase tracking-widest text-white/70 sm:px-10 lg:px-16"
  >
    <p class="hidden truncate sm:block">Envío a todo el país · Cambios sin cargo dentro de 30 días</p>

    <p class="flex items-center gap-1.5 font-semibold text-bone">
      <ShieldCheck class="h-3.5 w-3.5 text-steel" strokeWidth={2} aria-hidden="true" />
      <span>100% Originales</span>
      <span class="text-steel">·</span>
      <span>Autenticidad Verificada</span>
    </p>
  </div>
</div>
