# Panel Connect > el proyecto de Supabase (Settings > API Keys):
# https://supabase.com/dashboard/project/_/settings/api-keys
#
# PUBLIC_* se expone al navegador (Astro filtra por ese prefijo) — son seguras
# porque el acceso real lo controla RLS, no el secreto de esta clave.

PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Proyectos nuevos de Supabase muestran "Publishable key" (sb_publishable_...).
# Si tu proyecto todavía muestra el "anon key" clásico (formato eyJ...), usá ese
# valor acá igual — el nombre de la variable no importa, cumple la misma función.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Server-only. NUNCA se importa desde código que corre en el navegador ni desde
# ningún archivo bajo src/components o <script> de cliente.
# Ahora sí hace falta (antes no se usaba en ningún lado): la creación de
# pedidos en el checkout y la confirmación de pagos pasan por acá, porque un
# comprador invitado no tiene sesión de Supabase — no hay auth.uid() con el
# que RLS pueda decidir nada, así que esas dos operaciones puntuales se hacen
# con esta clave, que ignora RLS por completo. Está en Settings > API Keys,
# como "Secret key" (o "service_role" en proyectos viejos).
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Mercado Pago — server-only, nunca al cliente.
# Empezá siempre con las credenciales de PRUEBA, nunca las de producción,
# hasta haber probado una compra de punta a punta.
# Tus integraciones > tu aplicación > Credenciales > Credenciales de prueba.
# El access token de prueba arranca con "TEST-".
# ─────────────────────────────────────────────────────────────

# Tus integraciones > tu aplicación > Webhooks > Configurar notificaciones.
# Al guardar la URL de notificación ahí, Mercado Pago te genera esta clave.

# URL pública de tu sitio, SIN barra al final.
# En desarrollo local podés dejar localhost — el redirect del navegador
# después de pagar funciona igual — pero el webhook (notification_url) sólo
# le va a llegar a Mercado Pago si esta URL es alcanzable desde internet
# (por ejemplo, con ngrok). Mientras tanto, la página de éxito confirma el
# pago igual como respaldo — ver README.

